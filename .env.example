# ===== Frontend (Vite build args) =====
# Appwrite is the auth + database provider. The browser SDK uses these two
# variables to talk to Appwrite directly for sign-in (email OTP, GitHub OAuth)
# and for reading public catalog data.
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your-appwrite-project-id

# В проде фронт проксируется через nginx → /api, поэтому указываем относительные пути.
# Для локальной разработки (без docker) задайте полные URL, например http://localhost:8081
VITE_COMMERCE_API_URL=/api
VITE_TONFORGE_API_URL=/api/tonforge

# Публичный URL фронта (без слэша в конце); используется при npm run build для манифеста.
VITE_APP_ORIGIN=https://your-domain.com

# Опционально — URL репозитория GitHub для ссылки «Source» на странице /docs (manifest).
VITE_PUBLIC_REPO_URL=https://github.com/your-org/your-repo

# ===== Backend =====
# Set to `production` on deploy — enables production logger behaviour,
# Sentry flushing and disables dev-only stack traces.
NODE_ENV=production
PORT=8081
CORS_ORIGIN=https://your-domain.com

# Sentry DSN for backend error reporting (optional).
# When unset, sentry.ts silently skips initialisation.
SENTRY_DSN=

# Frontend Sentry DSN — read at build time by Vite.
VITE_SENTRY_DSN=

# In production, /api/health returns only `{ status: "OK" }` to avoid leaking
# which subsystems are configured. Set this token to allow operators to fetch
# the full status via `GET /api/health?detailed=1` with header
# `X-Health-Token: <token>`. Leave empty to disable detailed mode entirely.
HEALTH_DETAIL_TOKEN=

# Appwrite (серверный SDK).
# The backend validates incoming Bearer tokens by calling Account.get() on
# Appwrite. The API key is only used for admin-side reads/writes; user JWTs
# go through createUserContextClient(jwt).setJWT().
#
# Setup checklist (Appwrite Console):
#   1. Auth → Settings: enable Email/Password (magic link uses this surface).
#   2. Auth → Settings → OAuth2 Providers → GitHub: paste Client ID/Secret
#      from your GitHub OAuth App; the redirect URL is shown by Appwrite.
#   3. Auth → Templates → Magic URL: customise the email template.
#   4. (Optional) Auth → Settings → SMTP: plug in Resend for branded emails.
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your-appwrite-project-id
APPWRITE_API_KEY=your-appwrite-api-key

# ===== Commerce / TON =====
# Mainnet (default)
TREASURY_WALLET_ADDRESS=your-treasury-wallet
TONAPI_KEY=your-tonapi-key
TONAPI_BASE_URL=https://tonapi.io

# Explicit mainnet overrides (optional — fall back to TREASURY_WALLET_ADDRESS
# and TONAPI_* above when unset).
# TREASURY_WALLET_ADDRESS_MAINNET=
# TONAPI_BASE_URL_MAINNET=
# TONAPI_KEY_MAINNET=

# Testnet (optional, for runtime network switch)
TREASURY_WALLET_ADDRESS_TESTNET=your-testnet-treasury-wallet
TONAPI_BASE_URL_TESTNET=https://testnet.tonapi.io
# TONAPI_KEY_TESTNET=  # uses TONAPI_KEY if not set
PLATFORM_FEE_BPS=250
DISPUTE_WINDOW_SEC=86400
COMMERCE_ADMIN_SECRET=generate-a-strong-secret-here
BOOTSTRAP_SELLER_WALLET=
COMMERCE_JETTON_MASTER=

# ===== Resend (outbound + inbound email) =====
# 1. RESEND_API_KEY — Resend Dashboard → API Keys
# 2. RESEND_FROM — verified sender (домен должен пройти DNS verification в Resend)
# 3. RESEND_WEBHOOK_SECRET — для входящих писем: Resend Dashboard → Webhooks → Signing secret
# 4. PUBLIC_API_ORIGIN — публичный URL backend, используется для отображения webhook URL в админке
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM=TonForge <noreply@tonforge.app>
RESEND_WEBHOOK_SECRET=
PUBLIC_API_ORIGIN=https://api.your-domain.com

# ===== Cloudflare R2 (S3-compatible storage for builds) =====
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=ton-store-builds
# Optional public CDN base URL for assets/* (avatars, banners, covers).
# When empty, the backend streams them through /api/r2/asset/*.
R2_PUBLIC_URL=
# Upper bound for a single build upload (megabytes). Multer uses diskStorage
# and streams the file to R2 chunk-by-chunk, so RAM is O(1) per upload — this
# value only caps how much temp disk space the worst-case upload can use.
# Default: 100 MB. Override R2_BUILD_TMP_DIR to point at a dedicated volume.
R2_MAX_BUILD_MB=100
R2_BUILD_TMP_DIR=

# ===== VirusTotal (build scanning) =====
# Free tier: 4 req/min, 500/day, max 32 MB direct upload.
VIRUSTOTAL_API_KEY=
# Engines flagging the file as malicious required to auto-reject (default 1).
VIRUSTOTAL_THRESHOLD_MALICIOUS=1
# Engines flagging the file as suspicious required to send to manual review (default 3).
VIRUSTOTAL_THRESHOLD_SUSPICIOUS=3

# ===== Docker Compose (опционально) =====
WEB_HOST_PORT=80
API_HOST_PORT=8081
API_PORT=8081
