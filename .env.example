# ===== Frontend (Vite build args) =====
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your-appwrite-project-id
VITE_COMMERCE_API_URL=/api
VITE_TONFORGE_API_URL=/api/tonforge
VITE_APP_ORIGIN=https://your-domain.com
VITE_SENTRY_DSN=

# ===== Backend =====
NODE_ENV=production
PORT=8081
CORS_ORIGIN=https://your-domain.com

SENTRY_DSN=
HEALTH_DETAIL_TOKEN=

# Appwrite (server SDK)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your-appwrite-project-id
APPWRITE_API_KEY=your-appwrite-api-key

# ===== Commerce / TON =====
TREASURY_WALLET_ADDRESS=your-treasury-wallet
TONAPI_KEY=your-tonapi-key
TONAPI_BASE_URL=https://tonapi.io
PLATFORM_FEE_BPS=1500
TRIAL_WINDOW_SEC=259200
COMMERCE_ADMIN_SECRET=generate-a-strong-secret-here
# BOOTSTRAP_SELLER_WALLET=          # reserved, not yet wired in code
COMMERCE_JETTON_MASTER=             # required only when JETTON payments are enabled (not yet)

# Testnet overrides (optional)
TREASURY_WALLET_ADDRESS_TESTNET=your-testnet-treasury-wallet
TONAPI_BASE_URL_TESTNET=https://testnet.tonapi.io
TONAPI_KEY_TESTNET=

# Mainnet overrides (if different from defaults above)
# TREASURY_WALLET_ADDRESS_MAINNET=
# TONAPI_BASE_URL_MAINNET=https://tonapi.io
# TONAPI_KEY_MAINNET=

# ===== Ballerine KYC (seller identity verification) =====
# Self-hosted Ballerine stack (the "KYS" service). When unset, automated KYC is
# disabled and sellers use the manual verification card.
#   BALLERINE_API_URL   — workflows-service base URL (e.g. https://kyc-api.example)
#   BALLERINE_API_KEY   — workflows-service API key (sent in the authorization header)
#   BALLERINE_FLOW_URL  — kyb-app collection-flow base URL (e.g. https://kyc-flow.example)
BALLERINE_API_URL=
BALLERINE_API_KEY=
BALLERINE_FLOW_URL=
# Workflow definition id the seller flow runs (matches the kyb-app VITE_KYB_DEFINITION_ID).
BALLERINE_WORKFLOW_DEFINITION_ID=kyb_parent_kyc_session_example
# REQUIRED for KYC webhooks. The /sellers/kyc/webhook endpoint is fail-closed:
# without this secret (or without a valid HMAC signature over the RAW body) every
# webhook is rejected with 401, so sellers can never be auto-approved by a forged
# request.
BALLERINE_WEBHOOK_SECRET=

# ===== License NFT (TonForge on-chain) =====
# SERVER-AUTHORITATIVE network for BOTH payment verification (commerce) and the
# on-chain mint worker. The client `x-ton-network` header is advisory-only and
# is ignored — set this to the one network the deployment runs on (mainnet|testnet).
TON_NETWORK=testnet
TON_API_ENDPOINT=https://testnet.toncenter.com/api/v2/jsonRPC
TON_API_KEY=
ORACLE_MNEMONIC=
LICENSE_NFT_ITEM_CODE_BOC=
APP_COLLECTION_CODE_BOC=
LICENSE_MINT_GAS_NANO=150000000
LICENSE_BURN_GAS_NANO=70000000

# ===== Resend (email) =====
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM=TonForge <noreply@tonforge.org>
RESEND_WEBHOOK_SECRET=
PUBLIC_API_ORIGIN=https://api.your-domain.com

# ===== Cloudflare R2 (platform avatars/banners only — BYOS for builds) =====
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=ton-store-builds
R2_PUBLIC_URL=
R2_MAX_BUILD_MB=100
R2_BUILD_TMP_DIR=

# ===== BYOS Storage Encryption (REQUIRED for BYOS) =====
# Encrypts per-developer R2/S3 credentials at rest in Appwrite.
# Generate via: openssl rand -hex 32
STORAGE_ENCRYPTION_KEY=

# ===== VirusTotal =====
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_THRESHOLD_MALICIOUS=1
VIRUSTOTAL_THRESHOLD_SUSPICIOUS=3

# ===== AMLBot (AML-скоринг кошельков, backend/aml/amlbot.ts) =====
# Без AMLBOT_ACCESS_ID скоринг выключен: все кошельки проходят (fail-open).
# Креды выдаются в кабинете AMLBot после онбординга (amlbot.com/api-integration).
AMLBOT_ACCESS_ID=
AMLBOT_ACCESS_KEY=
# AMLBOT_API_URL=https://extrnlapiendpoint.silencatech.com/
# AMLBOT_ASSET=TON
AML_RISK_THRESHOLD=70
AML_CACHE_HOURS=168

# ===== Docker Compose =====
# WEB_HOST_PORT=80                  # not read by docker-compose (fixed port mapping)
# API_HOST_PORT=8081                # not read by docker-compose (fixed port mapping)
API_PORT=8081
