# ===== Frontend (Vite build args) =====
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key

VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your-appwrite-project-id

# В проде фронт проксируется через nginx → /api, поэтому указываем относительные пути.
# Для локальной разработки (без docker) задайте полные URL, например http://localhost:8081
VITE_COMMERCE_API_URL=/api
VITE_TONFORGE_API_URL=/api/tonforge

# Публичный URL фронта (без слэша в конце); используется при npm run build для манифеста.
VITE_APP_ORIGIN=https://your-domain.com

# ===== Backend =====
PORT=8081
CORS_ORIGIN=https://your-domain.com

# Clerk (auth)
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key
CLERK_WEBHOOK_SECRET=whsec_your-clerk-webhook-secret

# Appwrite (серверный SDK + Auth на фронте)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your-appwrite-project-id
APPWRITE_API_KEY=your-appwrite-api-key

# ===== Commerce / TON =====
# Mainnet (default)
TREASURY_WALLET_ADDRESS=your-treasury-wallet
TONAPI_KEY=your-tonapi-key
TONAPI_BASE_URL=https://tonapi.io
# Testnet (optional, for runtime network switch)
TREASURY_WALLET_ADDRESS_TESTNET=your-testnet-treasury-wallet
TONAPI_BASE_URL_TESTNET=https://testnet.tonapi.io
# TONAPI_KEY_TESTNET=  # uses TONAPI_KEY if not set
PLATFORM_FEE_BPS=250
DISPUTE_WINDOW_SEC=86400
COMMERCE_ADMIN_SECRET=generate-a-strong-secret-here
BOOTSTRAP_SELLER_WALLET=
COMMERCE_JETTON_MASTER=

# ===== Resend (email) — API key хранится в Coolify env =====
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM=TON Web Store <noreply@yourdomain.com>

# ===== Cloudflare R2 (S3-compatible storage for builds) =====
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=ton-store-builds

# ===== Docker Compose (опционально) =====
WEB_HOST_PORT=80
API_HOST_PORT=8081
API_PORT=8081
