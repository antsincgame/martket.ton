# ===== Frontend (Vite) =====
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your-appwrite-project-id

VITE_COMMERCE_API_URL=http://localhost:8081
VITE_TONCONNECT_MANIFEST_URL=

# ===== Backend =====
PORT=8081
JWT_SECRET=generate-a-strong-secret-here
CORS_ORIGIN=http://localhost:8080

# Supabase (backend — service role для серверных операций)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Appwrite (backend — серверный SDK)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your-appwrite-project-id
APPWRITE_API_KEY=your-appwrite-api-key

# ===== Commerce / TON =====
TREASURY_WALLET_ADDRESS=your-treasury-wallet
TONAPI_KEY=your-tonapi-key
TONAPI_BASE_URL=https://tonapi.io/v2
PLATFORM_FEE_BPS=250
COMMERCE_ADMIN_SECRET=generate-a-strong-secret-here
BOOTSTRAP_SELLER_WALLET=
COMMERCE_JETTON_MASTER=
