;; message opcode reader utility: only binary receivers
;; Returns 32 bit message opcode, otherwise throws the "Invalid incoming message" exit code
(slice, int) ~load_opcode_internal(slice s) asm( -> 1 0) "32 LDUQ 130 THROWIFNOT";

() recv_internal(int msg_value, cell in_msg_cell, slice in_msg) impure {
    
    ;; Context
    var cs = in_msg_cell.begin_parse();
    cs~skip_bits(2);
    var msg_bounceable = cs~load_int(1);
    var msg_bounced = cs~load_int(1);
    slice msg_sender_addr = cs~load_msg_addr();
    __tact_context = (msg_bounceable, msg_sender_addr, msg_value, cs);
    __tact_context_sender = msg_sender_addr;
    
    ;; Load contract data
    var ($self'appId, $self'ownerAddress, $self'nextItemIndex, $self'collectionContent, $self'commonContent) = $AppCollection$_contract_load();
    
    ;; Handle bounced messages
    if (msg_bounced) { return (); }
    var op = in_msg~load_opcode_internal();
    ;; Receive MintLicense message
    if (op == 0x6a3aaa14) {
        var $msg'queryId = in_msg~load_uint(64);
        var $msg'buyerAddress = in_msg~load_msg_addr();
        var $msg'escrowAddress = in_msg~load_msg_addr();
        var $msg'transferLimit = in_msg~load_uint(8);
        var $msg'individualContent = in_msg~load_ref();
        var $msg'burnDeadline = in_msg~load_uint(32);
        throw_unless(57323, ( equal_slices_bits(__tact_context_get_sender(), $self'ownerAddress) ));
        throw_unless(37629, ($Context$_get_value(__tact_context_get()) >= 100000000));
        int $index = $self'nextItemIndex;
        var ($init'code, $init'data) = $LicenseItem$_init_child($index, $global_myAddress(), $msg'buyerAddress, $msg'escrowAddress, $msg'transferLimit, $msg'individualContent, $msg'burnDeadline);
        slice $itemAddress = $global_contractAddress(($init'code, $init'data));
