    }
    
    ;; Receive ChangeOwner message
    if (op == 0x4d8b8b8b) {
        var $msg'queryId = in_msg~load_uint(64);
        var $msg'newOwner = in_msg~load_msg_addr();
        throw_unless(49958, ( equal_slices_bits(__tact_context_get_sender(), $self'ownerAddress) ));
        $self'ownerAddress = $msg'newOwner;
        $AppCollection$_contract_store(($self'appId, $self'ownerAddress, $self'nextItemIndex, $self'collectionContent, $self'commonContent));
        return ();
    }
    
    ;; Receive Deploy message
    if (op == 0x946a98b6) {
        var $deploy'queryId = in_msg~load_uint(64);
        ($self'appId, $self'ownerAddress, $self'nextItemIndex, $self'collectionContent, $self'commonContent)~$AppCollection$_fun_notify($DeployOk$_store_cell($DeployOk$_constructor_queryId($deploy'queryId), begin_cell()));
        $AppCollection$_contract_store(($self'appId, $self'ownerAddress, $self'nextItemIndex, $self'collectionContent, $self'commonContent));
        return ();
    }
    
    ;; Throw if not handled
    throw(130);
}
