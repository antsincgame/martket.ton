    var msg_bounceable = cs~load_int(1);
    var msg_bounced = cs~load_int(1);
    slice msg_sender_addr = cs~load_msg_addr();
    __tact_context = (msg_bounceable, msg_sender_addr, msg_value, cs);
    __tact_context_sender = msg_sender_addr;
    
    ;; Load contract data
    var ($self'index, $self'collection, $self'ownerAddress, $self'escrowAddress, $self'transferLimit, $self'transfers, $self'content, $self'burnDeadline) = $LicenseItem$_contract_load();
    
    ;; Handle bounced messages
    if (msg_bounced) { return (); }
    var op = in_msg~load_opcode_internal();
    ;; Receive Transfer message
    if (op == 0x5fcc3d14) {
        var $msg'queryId = in_msg~load_uint(64);
        var $msg'newOwner = in_msg~load_msg_addr();
        var $msg'responseTo = in_msg~load_msg_addr();
        var $msg'customPayload = in_msg~load_maybe_ref();
        var $msg'forwardAmount = in_msg~load_varuint16();
        var $msg'forwardPayload = in_msg;
        throw_unless(36952, ( equal_slices_bits(__tact_context_get_sender(), $self'ownerAddress) ));
        throw_unless(29964, ($self'transfers < $self'transferLimit));
        slice $prev = $self'ownerAddress;
        $self'ownerAddress = $msg'newOwner;
        $self'transfers = ($self'transfers + 1);
        if (($msg'forwardAmount > 0)) {
            $global_send($SendParameters$_constructor_to_value_mode_bounce_body($msg'newOwner, $msg'forwardAmount, 1, false, $OwnerAssigned$_store_cell($OwnerAssigned$_constructor_queryId_prevOwner_forwardPayload($msg'queryId, $prev, $msg'forwardPayload), begin_cell())));
        }
        $global_send($SendParameters$_constructor_to_value_mode_bounce_body($msg'responseTo, 0, 66, false, $Excesses$_store_cell($Excesses$_constructor_queryId($msg'queryId), begin_cell())));
        $LicenseItem$_contract_store(($self'index, $self'collection, $self'ownerAddress, $self'escrowAddress, $self'transferLimit, $self'transfers, $self'content, $self'burnDeadline));
        return ();
    }
    
    ;; Receive Burn message
    if (op == 0x595f07bc) {
        var $msg'queryId = in_msg~load_uint(64);
        throw_unless(59986, ( equal_slices_bits(__tact_context_get_sender(), $self'collection) ));
        $global_send($SendParameters$_constructor_to_value_mode_bounce_body($self'ownerAddress, 0, 160, false, __gen_cell_cell_0dd6a9c1524c235e999b4bff013afc6845af1fb15ede06d5f8d1bfd4068039da()));
        $LicenseItem$_contract_store(($self'index, $self'collection, $self'ownerAddress, $self'escrowAddress, $self'transferLimit, $self'transfers, $self'content, $self'burnDeadline));
        return ();
    }
    
    ;; Receive BuyerBurn message
    if (op == 0x7a1b3c5d) {
        var $msg'queryId = in_msg~load_uint(64);
        throw_unless(21543, ( equal_slices_bits(__tact_context_get_sender(), $self'ownerAddress) ));
        throw_unless(22636, ($global_now() <= $self'burnDeadline));
        $global_send($SendParameters$_constructor_to_value_mode_bounce_body($self'escrowAddress, 0, 64, false, $RefundOnBurn$_store_cell($RefundOnBurn$_constructor_(), begin_cell())));
        $LicenseItem$_contract_store(($self'index, $self'collection, $self'ownerAddress, $self'escrowAddress, $self'transferLimit, $self'transfers, $self'content, $self'burnDeadline));
        return ();
    }
    
    ;; Receive GetStaticData message
    if (op == 0x2fcb26a2) {
        var $msg'queryId = in_msg~load_uint(64);
        $global_send($SendParameters$_constructor_to_value_mode_bounce_body(__tact_context_get_sender(), 0, 64, false, $ReportStaticData$_store_cell($ReportStaticData$_constructor_queryId_index_collection($msg'queryId, $self'index, $self'collection), begin_cell())));
        $LicenseItem$_contract_store(($self'index, $self'collection, $self'ownerAddress, $self'escrowAddress, $self'transferLimit, $self'transfers, $self'content, $self'burnDeadline));
        return ();
    }
    
    ;; Receive Deploy message
    if (op == 0x946a98b6) {
        var $deploy'queryId = in_msg~load_uint(64);
        ($self'index, $self'collection, $self'ownerAddress, $self'escrowAddress, $self'transferLimit, $self'transfers, $self'content, $self'burnDeadline)~$LicenseItem$_fun_notify($DeployOk$_store_cell($DeployOk$_constructor_queryId($deploy'queryId), begin_cell()));
        $LicenseItem$_contract_store(($self'index, $self'collection, $self'ownerAddress, $self'escrowAddress, $self'transferLimit, $self'transfers, $self'content, $self'burnDeadline));
        return ();
    }
    
    ;; Throw if not handled
    throw(130);
}
