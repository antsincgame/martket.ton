;;
;; Routing of a Contract Escrow
;;

;; message opcode reader utility: only binary receivers
;; Returns 32 bit message opcode, otherwise throws the "Invalid incoming message" exit code
(slice, int) ~load_opcode_internal(slice s) asm( -> 1 0) "32 LDUQ 130 THROWIFNOT";

() recv_internal(int msg_value, cell in_msg_cell, slice in_msg) impure {
    
    ;; Context
    var cs = in_msg_cell.begin_parse();
    cs~skip_bits(2);
    var msg_bounceable = cs~load_int(1);
    var msg_bounced = cs~load_int(1);
    slice msg_sender_addr = cs~load_msg_addr();
    __tact_context = (msg_bounceable, msg_sender_addr, msg_value, cs);
    __tact_context_sender = msg_sender_addr;
    
    ;; Load contract data
    var ($self'orderId, $self'buyer, $self'seller, $self'treasury, $self'amountNano, $self'feeBps, $self'disputeWindowSec, $self'state, $self'paidAt) = $Escrow$_contract_load();
    
    ;; Handle bounced messages
    if (msg_bounced) { return (); }
    var op = in_msg~load_opcode_internal();
    ;; Receive PayEscrow message
    if (op == 3453919792) {
        var $msg = empty_tuple();
        throw_unless(27392, ($self'state == 0));
        throw_unless(15821, ( equal_slices_bits(__tact_context_get_sender(), $self'buyer) ));
        throw_unless(46647, ($Context$_get_value(__tact_context_get()) >= $self'amountNano));
        $self'state = 1;
        $self'paidAt = $global_now();
        $Escrow$_contract_store(($self'orderId, $self'buyer, $self'seller, $self'treasury, $self'amountNano, $self'feeBps, $self'disputeWindowSec, $self'state, $self'paidAt));
        return ();
    }
    
    ;; Receive ConfirmDelivery message
    if (op == 4104699808) {
        var $msg = empty_tuple();
        throw_unless(30244, ($self'state == 1));
        throw_unless(15821, ( equal_slices_bits(__tact_context_get_sender(), $self'buyer) ));
        ($self'orderId, $self'buyer, $self'seller, $self'treasury, $self'amountNano, $self'feeBps, $self'disputeWindowSec, $self'state, $self'paidAt)~$Escrow$_fun_releaseFunds();
