{
  "name": "ton-web-store-backend",
  "version": "1.0.0",
  "main": "server.ts",
  "scripts": {
    "start": "node --import tsx server.ts",
    "dev": "node --import tsx --watch server.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "provision-core": "node ../scripts/provision-core.mjs",
    "migrate-demiurge": "node ../scripts/provision-demiurge.mjs"
  },
  "license": "MIT",
  "description": "Backend API for TON Web Store",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1032.0",
    "@aws-sdk/s3-request-presigner": "^3.1032.0",
    "@sentry/node": "^10.49.0",
    "@ton/core": "^0.63.1",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^16.2.4",
    "@tonconnect/sdk": "^3.4.1",
    "@types/geoip-lite": "^1.4.4",
    "cors": "^2.8.6",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.2",
    "geoip-lite": "^2.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "node-appwrite": "^22.1.3",
    "resend": "^6.12.0",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3"
  }
