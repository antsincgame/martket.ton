# ============================================================
# Coolify: переменные окружения для docker-compose деплоя
# Скопируйте содержимое в Environment Variables проекта в Coolify
# ============================================================

# --- Сборка фронта (build args, нужны на этапе docker build) ---
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_COMMERCE_API_URL=/api
VITE_TONFORGE_API_URL=/api/tonforge
VITE_APP_ORIGIN=https://your-domain.com
VITE_TONCONNECT_MANIFEST_URL=

# --- Порты (опционально, Coolify может переопределить) ---
WEB_HOST_PORT=80
API_HOST_PORT=8081
API_PORT=8081

# --- API runtime ---
JWT_SECRET=
CORS_ORIGIN=https://your-domain.com

APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=

# --- Commerce / TON ---
TREASURY_WALLET_ADDRESS=
TONAPI_KEY=
TONAPI_BASE_URL=https://tonapi.io/v2
PLATFORM_FEE_BPS=1500
COMMERCE_ADMIN_SECRET=
BOOTSTRAP_SELLER_WALLET=
COMMERCE_JETTON_MASTER=

# --- License NFT (TonForge on-chain integration) ---
# Set TON_NETWORK=mainnet for production. Toncenter API key recommended
# (free tier limits at https://toncenter.com).
TON_NETWORK=testnet
TON_API_ENDPOINT=https://testnet.toncenter.com/api/v2/jsonRPC
TON_API_KEY=
# 24-word mnemonic of the oracle wallet — STORE IN COOLIFY SECRET, never plaintext.
ORACLE_MNEMONIC=
# Base64-encoded LicenseItem.code.boc and AppCollection.code.boc, see
# docs/license-nft-runbook.md for the build → encode flow.
LICENSE_NFT_ITEM_CODE_BOC=
APP_COLLECTION_CODE_BOC=
LICENSE_MINT_GAS_NANO=150000000
LICENSE_BURN_GAS_NANO=70000000
