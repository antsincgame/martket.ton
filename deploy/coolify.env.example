# Скопируйте в переменные окружения Coolify (или .env в корне репозитория для docker compose).
# Публичный URL фронта — в CORS_ORIGIN и в VITE_TONCONNECT_MANIFEST_URL; обновите public/tonconnect-manifest.json под прод-домен перед сборкой.
# Провижининг: npm run provision:appwrite && npm run provision:commerce && npm run provision:core

# --- Сборка фронта (build args) ---
VITE_APPWRITE_ENDPOINT=
VITE_APPWRITE_PROJECT_ID=
VITE_COMMERCE_API_URL=
VITE_TONFORGE_API_URL=
VITE_TONCONNECT_MANIFEST_URL=

# --- Порты при локальном compose (опционально) ---
WEB_HOST_PORT=80
API_HOST_PORT=8081
API_PORT=8081

# --- API runtime ---
JWT_SECRET=
CORS_ORIGIN=

APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=

TREASURY_WALLET_ADDRESS=
TONAPI_KEY=
PLATFORM_FEE_BPS=250
COMMERCE_ADMIN_SECRET=
