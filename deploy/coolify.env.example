# ============================================================
# Coolify: переменные окружения для docker-compose деплоя
# Скопируйте содержимое в Environment Variables проекта в Coolify
# ============================================================

# --- Сборка фронта (build args) ---
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_COMMERCE_API_URL=/api
VITE_TONFORGE_API_URL=/api/tonforge
VITE_APP_ORIGIN=https://your-domain.com

# --- Порты ---
API_PORT=8081

# --- API runtime ---
CORS_ORIGIN=https://your-domain.com
SENTRY_DSN=
HEALTH_DETAIL_TOKEN=

APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=

# --- Commerce / TON ---
TREASURY_WALLET_ADDRESS=
TONAPI_KEY=
TONAPI_BASE_URL=https://tonapi.io/v2
PLATFORM_FEE_BPS=1500
TRIAL_WINDOW_SEC=259200
COMMERCE_ADMIN_SECRET=
BOOTSTRAP_SELLER_WALLET=
COMMERCE_JETTON_MASTER=

# --- License NFT (TonForge on-chain) ---
TON_NETWORK=testnet
TON_API_ENDPOINT=https://testnet.toncenter.com/api/v2/jsonRPC
TON_API_KEY=
# Fallback USD/TON when price APIs fail (staging smoke / dev)
TON_USD_FALLBACK=5.5
ORACLE_MNEMONIC=
LICENSE_NFT_ITEM_CODE_BOC=
APP_COLLECTION_CODE_BOC=
LICENSE_MINT_GAS_NANO=150000000
LICENSE_BURN_GAS_NANO=70000000

# --- Staging Appwrite schema compat (omit attrs missing on legacy DB) ---
# Comma-separated listing field names to skip on create (e.g. priceUsd when at attribute cap)
LEGACY_LISTINGS_OMIT_FIELDS=priceUsd
LEGACY_PRODUCTS_OMIT_FIELDS=price_usd,scan_status

# --- Per-seller collections (Phase 1) ---
COLLECTION_OWNER_MNEMONIC_TESTNET=
COLLECTION_ADDRESS_TESTNET=
COLLECTION_METADATA_BASE=https://cdn.tonforge.org/collections

# --- Resend (email) ---
RESEND_API_KEY=
RESEND_FROM=TonForge <noreply@tonforge.org>
RESEND_WEBHOOK_SECRET=
PUBLIC_API_ORIGIN=https://api.your-domain.com

# --- Cloudflare R2 (platform avatars/banners only — BYOS for builds) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ton-store-builds
R2_PUBLIC_URL=
R2_MAX_BUILD_MB=100

# --- BYOS Storage Encryption (REQUIRED for BYOS) ---
# Generate via: openssl rand -hex 32
STORAGE_ENCRYPTION_KEY=

# --- VirusTotal ---
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_THRESHOLD_MALICIOUS=1
VIRUSTOTAL_THRESHOLD_SUSPICIOUS=3
