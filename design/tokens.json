{
  "$schema": "https://schemas.designtokens.org/draft/2024/tokens.json",
  "$description": "TonForge design tokens — W3C DTCG format. Portable into claude.ai/design, Figma (Tokens Studio), or Style Dictionary. Extracted from the live Tailwind config + the brand colors actually used across the React storefront and Demiurge/admin consoles.",
  "color": {
    "$type": "color",
    "brand": {
      "gold":   { "$value": "#FFD700", "$description": "Primary accent — Adeptus gold. Most-used (CTAs, seller console, highlights)." },
      "cyan":   { "$value": "#00F5FF", "$description": "Secondary accent — TON cyan. Buyer surface, links, focus." },
      "emerald":{ "$value": "#00FF88", "$description": "Success / minted / verified." },
      "violet": { "$value": "#8B5CF6", "$description": "Tertiary accent — agentic / AI surfaces." },
      "magenta":{ "$value": "#FF00FF", "$description": "Sparingly — neon emphasis, sacred glow." }
    },
    "feedback": {
      "danger":   { "$value": "#FF4444", "$description": "Errors, sanctions/AML blocks." },
      "danger-pink": { "$value": "#FF3B6B", "$description": "Wishlist heart, destructive accents." },
      "danger-deep": { "$value": "#FF2A6D", "$description": "Strong warnings." },
      "warning":  { "$value": "#FFB347", "$description": "Amber — mockup / pending / not-finalised." }
    },
    "surface": {
      "bg":        { "$value": "#0A0A0A", "$description": "App background (also TMA chrome)." },
      "bg-cool":   { "$value": "#0A0A0F", "$description": "Cooler near-black panels." },
      "panel":     { "$value": "#12121A", "$description": "Card / panel." },
      "panel-alt": { "$value": "#0D0D1A", "$description": "Inset / nested panel." },
      "border":    { "$value": "#2A2A3A", "$description": "Hairline borders." }
    },
    "text": {
      "primary": { "$value": "#FFFFFF" },
      "body":    { "$value": "#D8D8E8" },
      "dim":     { "$value": "#8A8AA0" },
      "muted":   { "$value": "#888888" },
      "faint":   { "$value": "#666666" }
    },
    "scale": {
      "ton":   { "500": { "$value": "#0066CC" }, "400": { "$value": "#1A8CFF" }, "300": { "$value": "#4DA6FF" } },
      "cosmic":{ "500": { "$value": "#4040FF" }, "400": { "$value": "#6666FF" } },
      "mystical": { "500": { "$value": "#FF4080" }, "400": { "$value": "#FF6699" } }
    }
  },
  "gradient": {
    "$type": "gradient",
    "ton":         { "$value": "linear-gradient(135deg, #4FACFE 0%, #00F2FE 100%)", "$description": "Primary CTA gradient (bg-ton-gradient)." },
    "cosmic":      { "$value": "linear-gradient(135deg, #667EEA 0%, #764BA2 100%)" },
    "mystical":    { "$value": "linear-gradient(135deg, #F093FB 0%, #F5576C 100%)" },
    "sacred":      { "$value": "linear-gradient(135deg, #FFECD2 0%, #FCB69F 100%)" },
    "enlightenment": { "$value": "linear-gradient(135deg, #A8EDEA 0%, #FED6E3 100%)" }
  },
  "fontFamily": {
    "$type": "fontFamily",
    "display": { "$value": ["Orbitron", "system-ui", "sans-serif"], "$description": "Headings / uppercase tracking — the machine-temple voice." },
    "sans":    { "$value": ["Inter Variable", "Inter", "system-ui", "sans-serif"], "$description": "Body." },
    "mono":    { "$value": ["Cascadia Code", "Fira Code", "monospace"], "$description": "Addresses, tokens, code." }
  },
  "fontWeight": {
    "$type": "fontWeight",
    "regular": { "$value": 400 },
    "semibold": { "$value": 600 },
    "bold": { "$value": 700 }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "0.5rem" },
    "md": { "$value": "0.75rem" },
    "lg": { "$value": "1rem" },
    "pill": { "$value": "9999px" }
  },
  "shadow": {
    "$type": "shadow",
    "glow-gold": { "$value": "0 0 20px rgba(255, 215, 0, 0.3)", "$description": "Hover glow on gold CTAs." },
    "glow-cyan": { "$value": "0 0 20px rgba(0, 245, 255, 0.3)", "$description": "Hover glow on cyan/buyer CTAs." }
  },
  "motion": {
    "$type": "duration",
    "fade-in":  { "$value": "250ms", "$description": "scale(0.95)→1 + opacity (animate-fade-in)." },
    "slide-in": { "$value": "300ms", "$description": "translateX(100%)→0 (toast / drawer)." },
    "float":    { "$value": "6s", "$description": "Idle hover loop (animate-float)." },
    "glow":     { "$value": "3s", "$description": "Pulsing box-shadow (animate-glow)." }
  }
}
